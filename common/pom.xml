    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Outbox і RabbitConfig напряму використовують tools.jackson (JsonMapper): не покладаємось на транзитивність -->
